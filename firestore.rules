rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    

    
    
    
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "animcinca84@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'xp', 'level', 'inventory', 'stats']) &&
             data.uid is string &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.xp is number && data.xp >= 0 &&
             data.level is number && data.level >= 1 &&
             data.inventory is list &&
             data.stats is map &&
             (!('role' in data) || data.role in ['admin', 'user']) &&
             (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
             (!('avatar' in data) || data.avatar is string) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 500));
    }

    function isValidListing(data) {
      return data.keys().hasAll(['sellerId', 'sellerName', 'itemId', 'itemName', 'price', 'createdAt']) &&
             data.sellerId == request.auth.uid &&
             data.sellerName is string &&
             data.itemId is string &&
             data.itemName is string &&
             data.price is number && data.price > 0 &&
             data.createdAt is timestamp;
    }

    function isValidTrade(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'receiverId', 'senderItems', 'receiverItems', 'status', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.senderName is string &&
             data.receiverId is string &&
             data.senderItems is list &&
             data.receiverItems is list &&
             data.status in ['pending', 'accepted', 'rejected'] &&
             data.createdAt is timestamp;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['action', 'timestamp']) &&
             data.action is string &&
             data.timestamp is timestamp;
    }

    
    
    

    
    
    
    
    
    
    
    
    
    
    
    
    
    

    function isValidSnippet(data) {
      return data.keys().hasAll(['title', 'code', 'authorId', 'authorName', 'likes', 'stars', 'starredBy', 'commentCount', 'createdAt']) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 10000 &&
             data.authorId == request.auth.uid &&
             data.likes is number && data.likes >= 0 &&
             data.stars is number && data.stars >= 0 &&
             data.starredBy is list &&
             data.commentCount is number &&
             data.createdAt is timestamp;
    }

    match /snippets/{snippetId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidSnippet(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.authorId) && isValidSnippet(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'commentCount', 'stars', 'starredBy']))
      );
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /active_bosses/{bossId} {
      allow read, write, create, update, delete: if isAuthenticated();
    }

    match /ai_quests/{questId} {
      allow read, write, create, update, delete: if isAuthenticated();
    }

    match /friend_requests/{requestId} {
      allow read, write, create, update, delete: if isAuthenticated();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);
    }

    match /guilds/{guildId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.leaderId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      
      allow update: if isAdmin() || (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /marketplace/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidListing(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /trades/{tradeId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidTrade(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidLog(request.resource.data);
      allow update, delete: if false;
    }

    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
